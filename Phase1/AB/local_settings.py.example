# Copy to local_settings.py and fill in.  local_settings.py is gitignored.
#
# AB phase1 modules load settings from here.  An unknown name is a hard error.

# kdb servers: equity_master (and the tick ladders) on the order side;
# QATT_SERVER is the qatt HDB (read with --date); QATT_RDB_SERVER is the RDB
# (read for today, with no --date).
EQUITY_MASTER_SERVER = "kdb-host:5010"
QATT_SERVER = "kdb-host:5011"
QATT_RDB_SERVER = "kdb-host:5012"

# The process with the `quote` table, if it is not the qatt one: QUOTE_SERVER
# with --date (HDB), QUOTE_RDB_SERVER without (RDB).  Leave blank or
# commented out to use QATT_SERVER / QATT_RDB_SERVER.
# QUOTE_SERVER = "kdb-host:5013"
# QUOTE_RDB_SERVER = "kdb-host:5014"

# Where extract.py leaves phase1-YYYYMMDD.zip.
EXPORT_DIR = r"C:\path\to\phase1_export"

# NewCrosscode.csv, wherever it lives on this machine.
CROSSCODE_PATH = r"C:\path\to\NewCrosscode.csv"

# Optional settings below.

# The zone kdb stamps prints in.  Written into the zip's manifest, so
# downstream converts from what the export saw.
# KDB_TIMEZONE = "China Standard Time"

# The mail at the end of every run, with the HTML report attached.  Left
# out, no mail is sent.
# SMTP_HOST = "smtp-host"
# EMAIL_FROM = "phase1@example.com"
# EMAIL_TO = ["desk@example.com"]

# Performance tuning.
# SYM_CHUNK = 200
# MASTER_CHUNK = 5000
