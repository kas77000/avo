# Copy to settings.r beside the scripts (settings.r is gitignored) and set
# the paths for this machine. Forward slashes work on Windows.

CROSSCODE_PATH   <- "C:/path/to/CrossCode.csv"

# historical.r
OUTPUT_DIR       <- "C:/path/to/Historical"
NOTRADINGDAY_DIR <- "C:/path/to/NoTradingDay"

# historical.r, optional; left out or "" is the default.
# WORKERS: R processes writing the tick files. Default: one fewer than the
# PC's cores, at most 4. 1 writes from the job's own process.
# WORKERS          <- ""
# TICK_BLOCK: rows of ticks.csv read at a time. Default 500000.
# TICK_BLOCK       <- ""

# Every job appends to LOG_DIR/phase1-YYYYMMDD.log.
LOG_DIR          <- "C:/path/to/logs"

# The Windows timezone id kdb stamps prints in; left out or "", China
# Standard Time. Must match the zip's manifest "kdb timezone", or
# historical.r stops.
KDB_TIMEZONE     <- "China Standard Time"

# limit_up_down.r: written to TEMP, then copied to each environment.
LULD_OUT_TEMP    <- "C:/path/to/temp/limitUpDown.csv"
LULD_OUT_TEST    <- "C:/path/to/test/limitUpDown.csv"
LULD_OUT_PILOT   <- "C:/path/to/pilot/limitUpDown.csv"
LULD_OUT_PROD    <- "C:/path/to/prod/limitUpDown.csv"
INDIA_NSE_STRA   <- ""
INDIA_BSE_STRA   <- ""

# trading_data.r
TD_OUTPUT_PATH   <- "C:/path/to/TradingData.csv"

# Optional inputs: read when set, skipped (and logged) when "".
MSCI_MAPPING_PATH          <- ""
OPEN_AUCTION_OVERRIDE_PATH <- ""
HKEX_CAS_LIST_PATH         <- ""
INDIA_NSE_CAS_LIST_PATH    <- ""
INDIA_BSE_CAS_LIST_PATH    <- ""

# mail_report.r, run last by run_phase1.cmd: the recap mailed through
# SMTP_HOST (Windows PowerShell's Send-MailMessage, port 25, no login) from
# EMAIL_FROM to every address in EMAIL_TO. Any of them "", and no mail is
# sent; the report is still written to LOG_DIR.
SMTP_HOST        <- ""
EMAIL_FROM       <- ""
EMAIL_TO         <- c("")
# e.g. SMTP_HOST <- "smtp.example.invalid"
#      EMAIL_FROM <- "nova@example.invalid"
#      EMAIL_TO <- c("ops@example.invalid", "desk@example.invalid")
