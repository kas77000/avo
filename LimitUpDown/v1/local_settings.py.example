#  Copy to local_settings.py and edit.  local_settings.py is gitignored, so a
#  git pull is always clean and these survive it.
#
#  STRICT: a name this file sets that limit_up_down.py does not define is an
#  ERROR, not a new setting.  EMAIL_T0 with a zero would otherwise sit there
#  mailing no one.
#
#  Paths below are the ones in config_cash.xml.  Fill in the server names.

KDB_HOST = "CHANGEME"
KDB_PORT = 5010

CROSSCODE_PATH = r"CHANGEME"

#  where spol_JKT.tsr lives.  The repo ships a placeholder copy in config/;
#  point this at the ATS folder so the authoritative file is used instead.
TSR_DIR = r"CHANGEME"

OUT_TEMP = r"CHANGEME"
OUT_TEST = r"CHANGEME"
OUT_PILOT = r"CHANGEME"
OUT_PROD = r"CHANGEME"

SMTP_HOST = "CHANGEME"
EMAIL_FROM = "CHANGEME"
EMAIL_TO = []
