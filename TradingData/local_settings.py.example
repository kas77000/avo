# Copy to local_settings.py and fill in.  local_settings.py is gitignored.
#
# STRICT: an unknown name here is a hard error.  A typo'd EMAIL_T0 fails
# loudly rather than silently sending nowhere.

# The server hosting equity_master.  It is in neither the :5010/:5012 order
# pair nor the :5011/:5013 qatt pair - ask whoever runs kdb.
EQUITY_MASTER_SERVER = "CHANGEME:5010"

CROSSCODE_PATH = r"CHANGEME\CrossCode.csv"
OUTPUT_PATH = r"CHANGEME\TradingData.csv"
TEMP_PATH = r"CHANGEME\TradingData.tmp.csv"

# Optional.  Absent means the columns they feed are left blank, and the run
# says so rather than failing.
MSCI_MAPPING_PATH = ""
OPEN_AUCTION_OVERRIDE_PATH = ""
# The HKEX closing-auction list from the dico: ONE STOCK CODE PER LINE, no
# header - 5, 700, 941.
#
# THE MATCH IS INVERTED.  The list names what KEEPS a closing auction, so
# every other HKG-MAIN and HKG-GEM name is marked NO_CAS, warrants aside.
# A missing or empty file therefore marks NOTHING rather than marking
# everything, and the run says so.
#
# It fills half of Hong Kong.  The other half - CAS for HK ETFs - comes
# from an intraday Bloomberg TRADING_CONDITIONS_1 call that equity_master
# has no equivalent for, and stays unfilled.
HKEX_CAS_LIST_PATH = ""

# The two India closing-auction lists.  A name on its own exchange's list
# gets Segment = CAS.
#
# SPACE SEPARATED, with a header carrying `isin` and
# `eligible_in_closing_auction`.  The R job reads them as CSV, which finds
# no columns in a space file and quietly marks nothing - so a list that
# looks fine and changes no Segment is the bug, not the file.
INDIA_NSE_CAS_LIST_PATH = ""
INDIA_BSE_CAS_LIST_PATH = ""

SMTP_HOST = "CHANGEME"
EMAIL_FROM = "CHANGEME"
EMAIL_TO = ["CHANGEME"]
